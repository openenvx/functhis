{
  // OpenCode fixture with stdio server and functhis entry to skip
  "mcp": {
    "git-mcp": {
      "type": "local",
      "command": ["uvx", "mcp-server-git"],
      "enabled": true,
    },
    "functhis": {
      "type": "local",
      "command": ["fn", "serve"],
      "enabled": true,
    },
    "remote-sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": true,
    },
  },
}
